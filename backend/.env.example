# 复制成 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）
API_HOST=127.0.0.1
API_PORT=8010

# ===== LLM（OpenAI 兼容接口，自建/中转服务一般都兼容）=====
# 留空或设 LLM_MOCK=1 时进入离线 Mock 模式，不调用模型，方便开发调试
LLM_BASE_URL=http://175.27.225.51:4047/v1
LLM_API_KEY=EMPTY
LLM_MODEL=echo-2.2.2
LLM_MOCK=0
LLM_TIMEOUT=60
LLM_MAX_CONCURRENCY=4

# ===== 世界时钟 =====
# 现实 1 秒 = 游戏多少分钟（1.0 表示现实 1 分钟 = 游戏 1 小时）
GAME_MINUTES_PER_SECOND=1.0
WORLD_ENABLED=1

# ===== 记忆 =====
SHORT_TERM_TURNS=8
RETRIEVE_TOP_K=5
REFLECT_IMPORTANCE_SUM=30
